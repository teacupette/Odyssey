<UserControl x:Class="WpfDispatcherSimulationApp.View.MainScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfDispatcherSimulationApp.View"
             xmlns:UserControls="clr-namespace:WpfDispatcherSimulationApp.View.UserControls"

             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="200"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="500" MinWidth="50" MaxWidth="1000"/>
        </Grid.ColumnDefinitions>

        <!--Left Side (Controls)-->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition MinHeight="100"/>
                <RowDefinition Height="10" />
                <RowDefinition Height="130" MinHeight="70"/>
            </Grid.RowDefinitions>
            
            <!--Menu Top Bar-->
            <Rectangle Fill="LightGray"/>
            <Menu Background="LightGray" HorizontalAlignment="Left">
                <MenuItem   Height="40" Header="Exit" FontSize="26" Background="White" Click="Exit_Click"/>
            </Menu>
            <Menu Background="LightGray" HorizontalAlignment="Right">
                <MenuItem  Header="Incitednt 1" FontSize="26" Background="White"/>
                <MenuItem  Header="Incitednt 2" FontSize="26" Background="White"/>
                <MenuItem  Width="20" Height="40" FontSize="26" Background="Red"/>
            </Menu>

            <Rectangle Fill="White" Grid.Row="1"/>
            <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" CornerRadius="6" Padding="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="CallTranscricpt"
                       TextWrapping="Wrap"
                       Padding="10"
                       FontSize="14"
                       Text="Nan"/>
                </ScrollViewer>
            </Border>

            <GridSplitter HorizontalAlignment="Stretch" Grid.Row="2" Background="#FF5D4545" Foreground="#FF5A4242"/>


            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <UserControls:ObjectList x:Name="IncidentList" ObjectListHedder="Incidents" Grid.Column="0"/>
                <UserControls:ObjectList x:Name="StationList" ObjectListHedder="Stations" Grid.Column="1"/>
                <UserControls:ObjectList x:Name="UnitList" ObjectListHedder="Units" Grid.Column="2"/>


            </Grid>
        </Grid>

        <!--Main Splitter-->
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#FF946B6B" Foreground="#FFBF6161"/>

        <!--Right Side (Map)-->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="170"/>
            </Grid.RowDefinitions>


            <!-- Map -->
            <UserControls:Map x:Name="mapDisplay"/>
            <Button Content="Scale Map" Click="ScaleMap_Click" Width="60" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>


            <!-- Selected Item Information -->
            <Rectangle Grid.Row="1" Fill="Gray"/>
            <UserControls:SelectedObjectView x:Name="objectView" Grid.Row="2"/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
