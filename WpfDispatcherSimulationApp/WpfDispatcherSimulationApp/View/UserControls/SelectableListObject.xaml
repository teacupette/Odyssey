<UserControl x:Class="WpfDispatcherSimulationApp.View.UserControls.SelectableListObject"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfDispatcherSimulationApp.View.UserControls"
             mc:Ignorable="d" 
                      d:DesignHeight="50" d:DesignWidth="250">
    <Grid>
        
        <Rectangle Fill="LightGray"/>
        <Rectangle Fill="White" Margin="1"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" x:Name="icon" Source="/Assets/fire_truck_icon.png" RenderOptions.BitmapScalingMode="NearestNeighbor" Width="30" Height="30" Margin="5, 0, 5, 0"/>
            <TextBlock Grid.Column="1" x:Name="unitname" Text="Unit1" FontSize="20" Foreground="Gray" VerticalAlignment="Center" Margin="5, 0, 0, 0"/>
            <Button  Grid.Column="2" x:Name="clearButton" HorizontalAlignment="Right" Content="Select" FontSize="20" Background="Transparent" Foreground="LightGray" BorderThickness="0"/>

        </Grid>
        
    </Grid>
</UserControl>
