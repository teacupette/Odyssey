<UserControl x:Class="WpfDispatcherSimulationApp.View.UserControls.Map"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfDispatcherSimulationApp.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="480" d:DesignWidth="480">
    <Grid>
        <Canvas Name="mapCanvas" Grid.Row="0" Background="Wheat" ClipToBounds="True">
            <Image x:Name="icon" Source="/Assets/fire_truck_16x16.png" RenderOptions.BitmapScalingMode="NearestNeighbor" Canvas.Left="0" Canvas.Top="0"/>

        </Canvas>
    </Grid>
</UserControl>
