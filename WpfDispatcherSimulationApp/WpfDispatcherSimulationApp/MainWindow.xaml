<Window x:Class="WpfDispatcherSimulationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfDispatcherSimulationApp"
        xmlns:View="clr-namespace:WpfDispatcherSimulationApp.View"

        mc:Ignorable="d"
        
        Title="Dispatcher Simulation System (DSS)" Height="450" Width="800" Icon="/Assets/fire_truck_icon.png">

    <Grid>
        <View:StartScreen x:Name="startScreen" StartPressed="startScreen_StartPressed"/>
        <View:MainScreen x:Name="mainScreen" ExitPressed="mainScreen_ExitPressed"/>



    </Grid>
</Window>
